{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@leohenon/opencode-vim-plugin",
  "version": "0.0.0",
  "description": "Vim mode plugin for upstream OpenCode, powered by OCV.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run script/build.ts",
    "typecheck": "tsc --noEmit",
    "check:keymap": "bun run script/check-keymap.ts",
    "check:adapter": "bun run script/check-adapter.ts",
    "check": "bun run typecheck && bun run check:keymap && bun run build && bun run check:adapter"
  },
  "engines": {
    "opencode": ">=1.17.9"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.9",
    "@opentui/core": ">=0.4.2",
    "@opentui/keymap": ">=0.4.2",
    "@opentui/solid": ">=0.4.2"
  },
  "dependencies": {
    "@opentui/core": "^0.4.2",
    "@opentui/keymap": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.9",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
